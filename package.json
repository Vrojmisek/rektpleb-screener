{
  "name": "rektpleb-screener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs --dev",
    "start": "node scripts/start.mjs",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs market-policy.test.mjs",
    "verify": "npm run check && npm test && npm run build && npm run release:check",
    "release:check": "node scripts/release-check.mjs",
    "setup": "npm ci && npm run build",
    "format": "prettier --write src tests scripts *.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "lightweight-charts": "^5.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "description": "A local-first crypto market screener with live public data, full-screen charts and optional alert images.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
